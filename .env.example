# SAP Configuration (Environment Variables)
# Copy this file to .env and fill in your credentials
# IMPORTANT: .env is in .gitignore and should NEVER be committed

# SAP connection settings
SAP_LOGON_PATH=C:\\Program Files\\SAP\\FrontEnd\\SAP GUI\\saplogon.ini
SAP_USERNAME=demo_user
SAP_PASSWORD=your_password_here
SAP_CLIENT=100
SAP_LANG=EN

# Web application settings
APP_HOST=127.0.0.1
APP_PORT=8080
APP_DEBUG=false

# Logging settings
LOG_LEVEL=INFO

# Feature flags
FEATURE_SCREEN_INSPECTOR=false
FEATURE_SCRIPT_RUNNER=false
FEATURE_REPORT_ENGINE=false
